-    DEBUG_ERROR("Failed to get pipewire fd index: %s", err->message);
-    return -1;
-  }
-
-  int fd = g_unix_fd_list_get(fdList, index, &err);
-  if (err)
-  {
-    DEBUG_ERROR("Failed to get pipewire fd: %s", err->message);
-    return -1;
