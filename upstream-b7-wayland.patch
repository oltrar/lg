+
+static inline const struct spa_pod * lgPipewireFormat(
+  struct spa_pod_builder * builder, unsigned fps)
+{
+  return spa_pod_builder_add_object(builder,
+    SPA_TYPE_OBJECT_Format, SPA_PARAM_EnumFormat,
+    SPA_FORMAT_mediaType, SPA_POD_Id(SPA_MEDIA_TYPE_video),
+    SPA_FORMAT_mediaSubtype, SPA_POD_Id(SPA_MEDIA_SUBTYPE_raw),
+    /* Enum values contain the preferred default AND the allowed alternatives.
+     * Repeat BGRA in the alternatives or a BGRA-only producer is rejected. */
+    SPA_FORMAT_VIDEO_format, SPA_POD_CHOICE_ENUM_Id(5,
+      SPA_VIDEO_FORMAT_BGRA, SPA_VIDEO_FORMAT_BGRA, SPA_VIDEO_FORMAT_RGBA,
+      SPA_VIDEO_FORMAT_BGRx, SPA_VIDEO_FORMAT_RGBx),
+    SPA_FORMAT_VIDEO_size, SPA_POD_CHOICE_RANGE_Rectangle(
+      &SPA_RECTANGLE(1920, 1080), &SPA_RECTANGLE(1, 1), &SPA_RECTANGLE(8192, 8192)),
+    SPA_FORMAT_VIDEO_framerate, SPA_POD_CHOICE_RANGE_Fraction(
+      &SPA_FRACTION(0, 1), &SPA_FRACTION(0, 1), &SPA_FRACTION(fps, 1)),
+    SPA_FORMAT_VIDEO_maxFramerate, SPA_POD_CHOICE_RANGE_Fraction(
+      &SPA_FRACTION(fps, 1), &SPA_FRACTION(0, 1), &SPA_FRACTION(fps, 1)));
+}
+
+static inline const struct spa_pod * lgPipewireBuffers(struct spa_pod_builder * builder)
+{
+  return spa_pod_builder_add_object(builder,
+    SPA_TYPE_OBJECT_ParamBuffers, SPA_PARAM_Buffers,
+    SPA_PARAM_BUFFERS_dataType,
+      SPA_POD_CHOICE_FLAGS_Int((1 << SPA_DATA_MemPtr) | (1 << SPA_DATA_MemFd)));
+}
diff --git a/host/platform/Linux/capture/pipewire/src/frame_layout.h b/host/platform/Linux/capture/pipewire/src/frame_layout.h
new file mode 100644
--- /dev/null
+++ b/host/platform/Linux/capture/pipewire/src/frame_layout.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+struct LGFrameLayout
+{
+  size_t offset, sourcePitch, rowBytes, height, packedSize;
+};
+
+/* Reject negative strides and wrapped images. Offset is modulo maxsize. */
+static inline bool lgFrameLayout(struct LGFrameLayout * out,
+  uint32_t width, uint32_t height, uint32_t maxsize,
+  uint32_t offset, uint32_t size, int32_t stride)
+{
+  if (!out || !width || !height || !maxsize || stride < 0)
+    return false;
+  const size_t row = (size_t)width * 4;
+  if (row / 4 != width)
+    return false;
+  const size_t pitch = stride ? (size_t)stride : row;
+  const size_t start = offset % maxsize;
+  const size_t available = size < maxsize ? size : maxsize;
+  if (pitch < row || height > SIZE_MAX / row ||
+      height - 1 > (SIZE_MAX - row) / pitch)
+    return false;
+  const size_t span = ((size_t)height - 1) * pitch + row;
+  if (span > available || span > maxsize - start)
+    return false;
+  *out = (struct LGFrameLayout){start, pitch, row, height, row * height};
+  return true;
+}
+
+static inline void lgFramePack(uint8_t * dst, const uint8_t * src,
+  const struct LGFrameLayout * layout)
+{
+  src += layout->offset;
+  for (size_t y = 0; y < layout->height; ++y)
+    memcpy(dst + y * layout->rowBytes, src + y * layout->sourcePitch,
+      layout->rowBytes);
+}
